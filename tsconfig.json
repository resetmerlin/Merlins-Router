{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "checkJs": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": ["dist/**/*", "node_modules", "__tests__"]
}
